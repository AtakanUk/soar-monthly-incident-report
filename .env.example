# IBM QRadar SOAR connection
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
# Path to a CA bundle, or "false" to skip certificate verification (lab use only)
SOAR_CAFILE=

# Report options
REPORT_LOOKBACK_DAYS=30
REPORT_LONG_RUNNING_DAYS=2
# Comma-separated substrings; incidents whose name contains any of them are left out
REPORT_EXCLUDE_PATTERNS=
REPORT_ACTION_FIELD=action_info
REPORT_NOTIFIED_FIELD=second_info
REPORT_NOTIFIED_VALUE=Ok
REPORT_APPROVAL_FIELD=approval
REPORT_RECIPIENT_FIELD=mail_to_address
# Only needed when wkhtmltopdf is not on PATH
WKHTMLTOPDF_PATH=

# Mail delivery (only used with --send-mail)
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=soar-reports@example.com
MAIL_TO=soc-team@example.com
MAIL_CC=
MAIL_SUBJECT=[IBM QRadar SOAR] Monthly Incident Report
